[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

[libraries]
windows.debug.x86_64 = "res://rust/target/debug/webrtc_sync.dll"
windows.release.x86_64 = "res://rust/target/release/webrtc_sync.dll"
linux.debug.x86_64 = "res://rust/target/debug/libwebrtc_sync.so"
linux.release.x86_64 = "res://rust/target/release/libwebrtc_sync.so"
macos.debug = "res://rust/target/debug/libwebrtc_sync.dylib"
macos.release = "res://rust/target/release/libwebrtc_sync.dylib"
macos.debug.arm64 = "res://rust/target/debug/libwebrtc_sync.dylib"
macos.release.arm64 = "res://rust/target/release/libwebrtc_sync.dylib"
